#!/usr/bin/env bash
set -e

# Pre-commit hook: checks staged files only

# Retrieve list of staged files (Added, Copied, Modified)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$STAGED_FILES" ]; then
  exit 0
fi

echo "🔍 Running pre-commit checks on staged files..."

# 1. Syntax check on staged JavaScript / MJS files
JS_STAGED_FILES=$(echo "$STAGED_FILES" | grep -E '\.(js|mjs|cjs)$' || true)

if [ -n "$JS_STAGED_FILES" ]; then
  echo "⚡ Checking syntax on staged JS/MJS files..."
  for file in $JS_STAGED_FILES; do
    if [ -f "$file" ]; then
      node --check "$file"
    fi
  done
  echo "✅ Syntax checks passed."
fi

# 2. Run integration tests if rules, configs, or test fixtures are staged
RULE_CHANGES=$(echo "$STAGED_FILES" | grep -E '^(eslint/|stylelint/|test/|package\.json)' || true)

if [ -n "$RULE_CHANGES" ]; then
  echo "🧪 Lint configs or test fixtures staged. Running integration test suite..."
  npm test
  echo "✅ Integration tests passed."
fi

echo "🎉 Pre-commit checks passed successfully!"
exit 0
